# Inference output and local demo evidence.
CSV_OUTPUT=output/live_intent.csv
DEMO_AUDIT_ENABLED=true
DEMO_AUDIT_OUTPUT=output/change_feed_audit.jsonl

# Both modes use this JSON batch. false inserts it into Cosmos before the demo
# runner; true bypasses Cosmos and sends it directly to SLM -> CSV -> Kafka.
DEMO_SLM_BACKUP_ENABLED=false
DEMO_BATCH_SIZE=10
DEMO_DOCUMENT_DIR=input/demo-events
# Optional legacy alternative: one JSON array file instead of the directory.
DEMO_DOCUMENT_FILE=

# Cosmos DB change-feed input.
# COSMOS_CONNECTION is the Azure Functions connection-name prefix used by
# function_app.py. Managed identity is used with this account endpoint.
COSMOS_CONNECTION__accountEndpoint=https://YOUR-ACCOUNT.documents.azure.com:443/
COSMOS_DATABASE=NORA

# Source containers monitored for inserted and updated documents.
COSMOS_CHAT_CONTAINER=chat-history-uat
COSMOS_CONTEXT_CONTAINER=context-history-uat
COSMOS_TOOLS_CONTAINER=context-history-all-tools
COSMOS_FEEDBACK_CONTAINER=chat-feedback

# Existing lease containers used by the Cosmos DB change-feed processor.
# Create these in COSMOS_DATABASE with /id as the partition key.
COSMOS_CHAT_LEASE=leases-live-chat
COSMOS_CONTEXT_LEASE=leases-live-context
COSMOS_TOOLS_LEASE=leases-live-tools
COSMOS_FEEDBACK_LEASE=leases-live-feedback
COSMOS_PARTITION_KEY_PATH=/id

# Azure resource provisioning. Names must satisfy Azure naming rules.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-live-intent
AZURE_LOCATION=eastus
AZURE_COSMOS_ACCOUNT=globally-unique-live-intent
AZURE_FUNCTION_STORAGE_ACCOUNT=globallyuniqueliveintent

# Optional Function App managed-identity object ID. When supplied, the
# provisioner assigns Cosmos data access.
FUNCTION_PRINCIPAL_ID=

# Production inference endpoint (OpenAI-compatible Cloud Foundry route).
MODEL_ENDPOINT=https://YOUR-CF-ROUTE.example.com/v1
MODEL_DEPLOYMENT=YOUR-SLM
MODEL_API_KEY=
MODEL_API_KEY_HEADER=Authorization
MODEL_TIMEOUT_SECONDS=30

# Alternatively, use an Azure OpenAI deployment as the demo SLM. When
# AZURE_OPENAI_ENDPOINT is set, these values take precedence over MODEL_*.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=cosmos-changes
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
