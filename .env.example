# Azure Cosmos DB connection (authentication comes from DefaultAzureCredential)
COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
COSMOS_DATABASE=NORA

# Source containers
COSMOS_CHAT_CONTAINER=chat-history-uat
COSMOS_TOOLS_CONTAINER=context-history-all-tools
COSMOS_CONTEXT_CONTAINER=context-history-uat
COSMOS_FEEDBACK_CONTAINER=chat-feedback

# Local export location
OUTPUT_DIR=output

# Export mode: none, llm, or knowledge_graph
INGESTION_MODE=none

# 0 processes every chat with --all; use a small number for a trial run
BATCH_LIMIT=0

# Number of chat IDs held and processed in each batch
BATCH_SIZE=100
