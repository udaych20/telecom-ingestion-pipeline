# Azure Cosmos DB connection (authentication comes from DefaultAzureCredential)
COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
COSMOS_DATABASE=NORA

# Source containers
COSMOS_CHAT_CONTAINER=chat-history-uat
COSMOS_TOOLS_CONTAINER=context-history-all-tools
COSMOS_CONTEXT_CONTAINER=context-history-uat
COSMOS_FEEDBACK_CONTAINER=chat-feedback

# Local export location
OUTPUT_DIR=output

# Export mode: none, llm, or knowledge_graph
INGESTION_MODE=none

# 0 processes every chat with --all; use a small number for a trial run
BATCH_LIMIT=0

# Number of chat IDs held and processed in each batch
BATCH_SIZE=100

# Parallel Cosmos lookups during historical batch processing
MAX_WORKERS=10

# Historical ranges are supplied with --start-time and optional --end-time.
# Both accept ISO 8601 values with an explicit timezone.

# Continuous ingestion. Historical commands remain available when this is false.
LIVE_STREAM_DATA_ENABLED=false

# Live transport used by `python app.py --live`: event_hubs or kafka
LIVE_STREAM_PROVIDER=event_hubs

# Successful event IDs are retained here to make broker replays idempotent.
LIVE_STREAM_STATE_DATABASE=output/live_stream_state.db
LIVE_STREAM_MAX_PROCESSING_ATTEMPTS=5
LIVE_STREAM_RETRY_INITIAL_SECONDS=1

# Azure Event Hubs subscriber (passwordless authentication)
LIVE_STREAM_EVENT_HUB_NAMESPACE=YOUR-NAMESPACE.servicebus.windows.net
LIVE_STREAM_EVENT_HUB_NAME=cosmos-changes
LIVE_STREAM_EVENT_HUB_CONSUMER_GROUP=telecom-ingestion-live
LIVE_STREAM_EVENT_HUB_STARTING_POSITION=@latest
LIVE_STREAM_CHECKPOINT_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE-ACCOUNT.blob.core.windows.net
LIVE_STREAM_CHECKPOINT_BLOB_CONTAINER=telecom-ingestion-checkpoints

# Kafka subscriber. Inject usernames/passwords through a secret store in production.
LIVE_STREAM_KAFKA_BOOTSTRAP_SERVERS=YOUR-KAFKA-BROKERS:9092
LIVE_STREAM_KAFKA_TOPIC=cosmos-changes
LIVE_STREAM_KAFKA_CONSUMER_GROUP=telecom-ingestion-live
LIVE_STREAM_KAFKA_CLIENT_ID=telecom-ingestion-pipeline
LIVE_STREAM_KAFKA_AUTO_OFFSET_RESET=latest
LIVE_STREAM_KAFKA_SECURITY_PROTOCOL=SASL_SSL
LIVE_STREAM_KAFKA_SASL_MECHANISM=PLAIN
LIVE_STREAM_KAFKA_USERNAME=
LIVE_STREAM_KAFKA_PASSWORD=
LIVE_STREAM_KAFKA_CA_LOCATION=
