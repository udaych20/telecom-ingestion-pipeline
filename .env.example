# Cosmos account endpoint; authentication uses DefaultAzureCredential.
COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
# Cosmos database containing the NORA records.
COSMOS_DATABASE=NORA
# Source container used by intent_app.py for classification.
COSMOS_CONTAINER=context-history

# Run the historical classification flow before any streaming flow.
INITIAL_LOAD_ENABLED=true
# Start the Azure Functions change-feed host after the initial flow.
STREAM_LOAD_ENABLED=false
# Optional inclusive historical start time with timezone; blank reads from the beginning.
INITIAL_START_TIME=
# Optional inclusive historical end time with timezone; blank uses the process start time.
INITIAL_END_TIME=
# Number of Cosmos records requested per SDK page.
INITIAL_BATCH_SIZE=500

# Directory for classified and reporting CSV files.
CSV_OUTPUT_DIR=output/csv
# Directory for Foundry train, validation, and test files.
FEATURE_OUTPUT_DIR=output/features
# Directory for training logs and job receipts.
LOG_OUTPUT_DIR=output/logs
# Main classified output filename; CSV, JSONL, and NDJSON are supported.
INTENT_OUTPUT=intent_labels_all.csv
# Intent-level record and unique-CID count report.
INTENT_COUNT_OUTPUT=intent_labels_all_counts.csv
# Export flattened source fields together with generated labels.
INTENT_INCLUDE_SOURCE_FIELDS=true
# Maximum source records to classify; blank processes every matching record.
INTENT_MAX_RECORDS=
# Cosmos classification readers; the synchronous client currently uses one.
INTENT_MAX_WORKERS=1
# Run a second Cosmos inventory pass to find records missing from the first read.
INTENT_FIND_MISSING=true
# CSV filename for records found only during the inventory pass.
INTENT_MISSING_OUTPUT=intent_labels_missing.csv
# Write generated labels to a separate Cosmos container.
INTENT_WRITE_BACK=false
# Existing Cosmos container that receives labels when write-back is enabled.
INTENT_TARGET_CONTAINER=intent-labels

# Write an informational training manifest and log without training a model.
TRAINING_PLACEHOLDER_ENABLED=true
# CSV filename containing intent counts prepared for training review.
TRAINING_MANIFEST_OUTPUT=training_manifest.csv
# Log filename explaining that placeholder training was not executed.
TRAINING_LOG_OUTPUT=training.log

# Generate Microsoft Foundry-compatible train, validation, and test datasets.
FEATURE_BUILD_ENABLED=false
# Foundry training dataset filename.
FOUNDRY_TRAIN_OUTPUT=foundry_train.jsonl
# Foundry validation dataset filename.
FOUNDRY_VALIDATION_OUTPUT=foundry_validation.jsonl
# Independent test dataset filename; this file is never uploaded for training.
FOUNDRY_TEST_OUTPUT=foundry_test.jsonl
# CSV report of accepted and rejected Feature Build records.
FEATURE_REPORT_OUTPUT=foundry_feature_report.csv
# Percentage of CIDs assigned to training.
TRAIN_PERCENT=80
# Percentage of CIDs assigned to validation.
VALIDATION_PERCENT=10
# Percentage of CIDs assigned to independent testing.
TEST_PERCENT=10
# Stable seed used to keep each CID in the same dataset across runs.
FEATURE_SPLIT_SEED=nora-intent-v1
# Mask common email, phone, account, and device identifiers.
FEATURE_REDACT_PII=true
# Exclude labels marked as needing human review.
FEATURE_EXCLUDE_NEEDS_REVIEW=true
# Require explicit approved or accepted human review before using a label.
FEATURE_REQUIRE_REVIEWED_LABELS=false

# Upload datasets and submit a paid Microsoft Foundry fine-tuning job.
FOUNDRY_TRAINING_ENABLED=false
# Microsoft Foundry project endpoint used with DefaultAzureCredential.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# Supported Foundry base model and version to fine-tune.
FOUNDRY_FINE_TUNE_MODEL=gpt-4.1-2025-04-14
# Short name suffix added to the customized model.
FOUNDRY_FINE_TUNE_SUFFIX=nora-intent
# Reproducibility seed sent to the fine-tuning job.
FOUNDRY_FINE_TUNE_SEED=105
# Foundry capacity type, such as GlobalStandard, Standard, or Developer.
FOUNDRY_FINE_TUNE_TRAINING_TYPE=GlobalStandard
# Maximum seconds to wait for Foundry to validate each uploaded file.
FOUNDRY_FILE_TIMEOUT_SECONDS=900
# Seconds between Foundry file-status checks.
FOUNDRY_POLL_SECONDS=10
# JSON filename used to save the submitted job and file IDs.
FOUNDRY_TRAINING_RECEIPT=foundry_training_job.json

# Upload generated artifacts to an existing Blob or ADLS Gen2 container.
ADLS_UPLOAD_ENABLED=false
# Blob endpoint for the storage account.
ADLS_ACCOUNT_URL=https://YOUR-STORAGE-ACCOUNT.blob.core.windows.net
# Existing Blob or ADLS Gen2 container receiving generated artifacts.
ADLS_CONTAINER=nora-intent
# Virtual folder prefix used for uploaded artifacts.
ADLS_BLOB_PREFIX=intent-training

# Chat-history container used by app.py and the streaming trigger.
COSMOS_CHAT_CONTAINER=chat-history-uat
# All-tools context container used by app.py and the streaming trigger.
COSMOS_TOOLS_CONTAINER=context-history-all-tools
# Detailed-context container used by app.py and the streaming trigger.
COSMOS_CONTEXT_CONTAINER=context-history-uat
# Feedback container used by app.py and the streaming trigger.
COSMOS_FEEDBACK_CONTAINER=chat-feedback
# Lease container for the chat-history change feed.
COSMOS_CHAT_CONTAINER_LEASE=leases-chat
# Lease container for the all-tools change feed.
COSMOS_TOOLS_CONTAINER_LEASE=leases-tools
# Lease container for the detailed-context change feed.
COSMOS_CONTEXT_CONTAINER_LEASE=leases-context
# Lease container for the feedback change feed.
COSMOS_FEEDBACK_CONTAINER_LEASE=leases-feedback
# Cosmos connection setting consumed by the Azure Functions trigger.
COSMOS_CONNECTION__accountEndpoint=https://YOUR-ACCOUNT.documents.azure.com:443/

# Azure Functions host storage; UseDevelopmentStorage requires local Azurite.
AzureWebJobsStorage=UseDevelopmentStorage=true
# Tell Azure Functions to run the Python worker.
FUNCTIONS_WORKER_RUNTIME=python
# Event Hubs namespace used by the managed-identity publisher.
EVENT_HUB_NAMESPACE=YOUR-NAMESPACE.servicebus.windows.net
# Event Hub receiving compact Cosmos change notifications.
EVENT_HUB_NAME=nora-updates
# Event Hubs namespace connection setting used by the Functions subscriber.
EVENT_HUB_CONNECTION__fullyQualifiedNamespace=YOUR-NAMESPACE.servicebus.windows.net
# Consumer group used by the Event Hubs-triggered subscriber.
EVENT_HUB_CONSUMER_GROUP=nora-update-subscriber
# Streaming Function log level.
NORA_LOG_LEVEL=INFO

# Local directory used by the interaction assembly application.
OUTPUT_DIR=output
# Downstream interaction export mode: none, llm, or knowledge_graph.
INGESTION_MODE=none
# Maximum chats for app.py --all; zero means every chat.
BATCH_LIMIT=0
# Number of chat IDs processed in each app.py batch.
BATCH_SIZE=100
# Number of concurrent app.py interaction workers.
MAX_WORKERS=10
