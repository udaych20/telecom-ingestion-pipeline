# Runtime configuration loaded by: python intent_app.py
# Existing process environment values override this file.
# Paths are relative to the working directory unless an absolute path is supplied.
# Azure Cosmos DB connection settings.
# Authentication is supplied by DefaultAzureCredential; do not put account keys here.
COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
# Database containing the source records.
COSMOS_DATABASE=YOUR-DATABASE
# Container read by the initial intent classification flow.
COSMOS_CONTAINER=context-history

# One command controls both phases: python intent_app.py
# initial=true/stream=false: historical load only
# initial=false/stream=true: continuous Azure Functions host only
# both=true: initial load first, then keep the stream host running
INITIAL_LOAD_ENABLED=true
# Start continuous change-feed processing; local execution requires func.
STREAM_LOAD_ENABLED=false

# Optional inclusive historical window. Leave both empty to read all records.
# Values must include a timezone, for example 2026-09-04T18:00:00+05:30.
# Command-line --start-time/--end-time values take precedence.
INITIAL_START_TIME=
# End of the historical window; blank uses the start time of this run when a start is set.
INITIAL_END_TIME=

# Cosmos SDK page size for the initial read. Leave empty for the SDK default.
INITIAL_BATCH_SIZE=500

# Optional timeframe filters can also be supplied with --start-time/--end-time.

# Local artifact layout. A configured absolute path or a path containing its own
# directory is kept as-is; bare filenames are placed in these directories.
CSV_OUTPUT_DIR=output/csv
# Directory for Foundry datasets and their quality report.
FEATURE_OUTPUT_DIR=output/features
# Directory for placeholder logs and submitted training job receipts.
LOG_OUTPUT_DIR=output/logs

# Output must end with .csv, .jsonl, or .ndjson.
INTENT_OUTPUT=intent_labels_all.csv

# Intent-wise classified-record and unique-CID count report. When omitted, the
# default is <INTENT_OUTPUT stem>_counts.csv beside the main output.
INTENT_COUNT_OUTPUT=intent_labels_all_counts.csv

# true exports every source JSON key as a flattened CSV/JSONL field.
INTENT_INCLUDE_SOURCE_FIELDS=true

# Leave empty to process every record. Example test value: 500
INTENT_MAX_RECORDS=

# The installed synchronous Cosmos client uses one reader. Values above 1 are
# ignored so they cannot be passed incorrectly to the HTTP client.
INTENT_MAX_WORKERS=1

# Run a second Cosmos inventory pass and save records that were absent from the
# first read. INTENT_MAX_RECORDS must be empty when this check is enabled.
INTENT_FIND_MISSING=true
# Separate CSV for records discovered by the second inventory pass.
INTENT_MISSING_OUTPUT=intent_labels_missing.csv

# Keep false for read-only analysis. When true, labels are also written to the
# separate existing container named by INTENT_TARGET_CONTAINER.
INTENT_WRITE_BACK=false
# Existing destination container for optional label write-back.
INTENT_TARGET_CONTAINER=intent-labels

# Produce dummy training inputs/status only; this does not train a model.
TRAINING_PLACEHOLDER_ENABLED=true
# Intent-count manifest for review; it does not start training.
TRAINING_MANIFEST_OUTPUT=training_manifest.csv
# Log recording placeholder output creation.
TRAINING_LOG_OUTPUT=training.log

# Build Microsoft Foundry-compatible chat JSONL datasets. Splitting is stable by
# conversation_id, so all rows for a CID stay in exactly one dataset.
FEATURE_BUILD_ENABLED=false
# Examples used to teach the model.
FOUNDRY_TRAIN_OUTPUT=foundry_train.jsonl
# Separate examples used to monitor training quality.
FOUNDRY_VALIDATION_OUTPUT=foundry_validation.jsonl
# Held-out examples for final evaluation; never submitted for training.
FOUNDRY_TEST_OUTPUT=foundry_test.jsonl
# Accepted and rejected record counts from Feature Build.
FEATURE_REPORT_OUTPUT=foundry_feature_report.csv
# Approximate training share by CID; all three percentages must total 100.
TRAIN_PERCENT=80
# Approximate validation share by CID; the current config parser requires a positive value.
VALIDATION_PERCENT=10
# Approximate test share by CID; the current config parser requires a positive value.
TEST_PERCENT=10
# Fixed value that makes CID assignment repeatable across runs.
FEATURE_SPLIT_SEED=nora-intent-v1
# Mask common email and numeric identifiers; this is basic masking, not full PII detection.
FEATURE_REDACT_PII=true
# Skip classifications marked as needing human review.
FEATURE_EXCLUDE_NEEDS_REVIEW=true
# Set true only after labels contain human_reviewed=true or an approved/accepted
# review.status. Rule-generated labels alone are not evidence of human approval.
FEATURE_REQUIRE_REVIEWED_LABELS=false

# Paid external action. When true, upload train/validation JSONL to Microsoft
# Foundry and submit a supervised fine-tuning job. This does not deploy the model.
FOUNDRY_TRAINING_ENABLED=false
# Requires Feature Build, at least 10 training rows, and a nonempty validation set.
# Project endpoint used with DefaultAzureCredential.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# Example base model version; choose one supported by your Foundry resource.
FOUNDRY_FINE_TUNE_MODEL=gpt-4.1-2025-04-14
# Short suffix for the customized model name.
FOUNDRY_FINE_TUNE_SUFFIX=nora-intent
# Positive training seed; leave blank to let the service choose.
FOUNDRY_FINE_TUNE_SEED=105
# Training capacity type supported by your selected model and resource.
FOUNDRY_FINE_TUNE_TRAINING_TYPE=GlobalStandard
# Maximum wait in seconds for each uploaded file to finish processing.
FOUNDRY_FILE_TIMEOUT_SECONDS=900
# Seconds between uploaded-file status checks; this does not monitor training completion.
FOUNDRY_POLL_SECONDS=10
# Job and uploaded-file IDs saved after submission; each run overwrites this local file.
FOUNDRY_TRAINING_RECEIPT=foundry_training_job.json

# Optional Blob Storage / ADLS Gen2 upload of label, count, and training files.
# Authentication uses DefaultAzureCredential.
ADLS_UPLOAD_ENABLED=false
# Blob endpoint works with normal Blob Storage and ADLS Gen2 accounts.
ADLS_ACCOUNT_URL=https://YOUR-STORAGE-ACCOUNT.blob.core.windows.net
# Existing destination container; the code does not create it.
ADLS_CONTAINER=nora-intent
# Prefix for uploaded filenames; matching existing blobs are overwritten.
ADLS_BLOB_PREFIX=intent-training

# Streaming settings used when STREAM_LOAD_ENABLED=true. The source triggers,
# leases, Event Hub publisher, and subscriber live in event_app/function_app.py.
# Use a real Azure Storage connection in deployed environments. The development
# value requires Azurite when running the Functions host locally.
AzureWebJobsStorage=UseDevelopmentStorage=true
# Azure Functions worker language.
FUNCTIONS_WORKER_RUNTIME=python
# Streaming log level: DEBUG, INFO, WARNING, or ERROR.
NORA_LOG_LEVEL=INFO
# Cosmos endpoint consumed by the Function trigger; use the same account as above.
COSMOS_CONNECTION__accountEndpoint=https://YOUR-ACCOUNT.documents.azure.com:443/
# Chat container watched for inserts and updates.
COSMOS_CHAT_CONTAINER=chat-history-uat
# Existing chat change-feed lease container, partitioned by /id.
COSMOS_CHAT_CONTAINER_LEASE=leases-chat
# Tools container watched for inserts and updates.
COSMOS_TOOLS_CONTAINER=context-history-all-tools
# Existing tools change-feed lease container, partitioned by /id.
COSMOS_TOOLS_CONTAINER_LEASE=leases-tools
# Context container watched for inserts and updates.
COSMOS_CONTEXT_CONTAINER=context-history-uat
# Existing context change-feed lease container, partitioned by /id.
COSMOS_CONTEXT_CONTAINER_LEASE=leases-context
# Feedback container watched for inserts and updates.
COSMOS_FEEDBACK_CONTAINER=chat-feedback
# Existing feedback change-feed lease container, partitioned by /id.
COSMOS_FEEDBACK_CONTAINER_LEASE=leases-feedback
# Event Hubs namespace used by the publisher.
EVENT_HUB_NAMESPACE=YOUR-NAMESPACE.servicebus.windows.net
# Namespace used by the subscriber trigger; normally the same as above.
EVENT_HUB_CONNECTION__fullyQualifiedNamespace=YOUR-NAMESPACE.servicebus.windows.net
# Existing Event Hub receiving change notifications.
EVENT_HUB_NAME=nora-updates
# Existing consumer group used by the logging subscriber.
EVENT_HUB_CONSUMER_GROUP=nora-update-subscriber
