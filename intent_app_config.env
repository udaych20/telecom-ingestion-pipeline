# Azure Cosmos DB connection settings.
# Authentication is supplied by DefaultAzureCredential; do not put account keys here.
COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
COSMOS_DATABASE=YOUR-DATABASE
COSMOS_CONTAINER=context-history

# Output must end with .csv, .jsonl, or .ndjson.
INTENT_OUTPUT=intent_labels_all.csv

# true exports every source JSON key as a flattened CSV/JSONL field.
INTENT_INCLUDE_SOURCE_FIELDS=true

# Leave empty to process every record. Example test value: 500
INTENT_MAX_RECORDS=

# Keep false for read-only analysis. When true, labels are also written to the
# separate existing container named by INTENT_TARGET_CONTAINER.
INTENT_WRITE_BACK=false
INTENT_TARGET_CONTAINER=intent-labels

